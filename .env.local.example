# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used to build the WhatsApp message + QR codes
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard
# ADMIN_PASSWORD is only used until a real password is set from
# /admin/settings (which stores a hash in the database) — keep it as a
# bootstrap fallback after that, or leave it, it stops being checked once a
# hash exists.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too-a-long-random-string

# Lets /admin/reset-password rehash a forgotten admin password without email
# sending wired up — pick any long random string, share it only with whoever
# manages the server.
ADMIN_RECOVERY_KEY=change-me-too-a-long-random-string
